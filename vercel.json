{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/server.js"
        },
        {
            "source": "/",
            "destination": "/frontend/views/login.html"
        },
        {
            "source": "/login",
            "destination": "/frontend/views/login.html"
        },
        {
            "source": "/select-user",
            "destination": "/frontend/views/select-user.html"
        },
        {
            "source": "/views/select-user.html",
            "destination": "/frontend/views/select-user.html"
        },
        {
            "source": "/views/login.html",
            "destination": "/frontend/views/login.html"
        },
        {
            "source": "/class",
            "destination": "/frontend/servant-class/class.html"
        },
        {
            "source": "/servant-class/class.html",
            "destination": "/frontend/servant-class/class.html"
        },
        {
            "source": "/stats",
            "destination": "/frontend/all-kids-stats/stats.html"
        },
        {
            "source": "/all-kids-stats/stats.html",
            "destination": "/frontend/all-kids-stats/stats.html"
        },
        {
            "source": "/honor",
            "destination": "/frontend/honor-board/honor.html"
        },
        {
            "source": "/honor-board/honor.html",
            "destination": "/frontend/honor-board/honor.html"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/$1"
        }
    ]
}